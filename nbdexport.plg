<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "NbdExport">
<!ENTITY author "RifleJock">
<!--
  Versioning — Unraid plugin updates use strcmp() (lexicographic).
  YYYY.MM.DD then aa, ab, … same day. No hyphens.
  Same rules as StorageGuard / ThunderboltNet / UnraidFRR.
-->
<!ENTITY version "2026.08.11ae">
<!ENTITY launch "Settings/NbdExport">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/NbdExport/main/nbdexport.plg">
<!ENTITY github "ibigsnet/NbdExport">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/NbdExport/main">
<!ENTITY plugdir "/usr/local/emhttp/plugins/NbdExport">
<!ENTITY configdir "/boot/config/plugins/NbdExport">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="database"
  min="6.12.0"
  support="https://github.com/&github;/issues"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- UI: numbered sections with full-width dividers; action bars under each block so listener vs image job are visually separate.

###2026.08.11ad
- UX/docs: “Start NBD listener” vs image job (server/client); how-to-use guide with scenarios; clearer helpers and status wording.

###2026.08.11ac
- Safety: Destructive mode (default Off) like Unassigned Devices — blocks writable and array/mounted/flash exports; UI confirms; image jobs refuse /dev output.

###2026.08.11ab
- UI: layout unified with UnraidFRR/Thunderbolt Net (dl/dt/dd, inline_help, companion strip, status table, Apply/Done).

###2026.08.11aa
- Docs/UI: Unraid product min 6.12 vs qemu tools (not kernel); clearer Status missing-tool text.

###2026.08.11
- Initial public release: Network Services → NBD, RO qemu-nbd export, image job (nbd:// → qcow2/raw), bind IP picker (Thunderbolt first), docs (when to use, vs NFS/SMB, security).
- Soft companions: Thunderbolt Net (prefer TB bind), UnraidFRR (docs only). Clean uninstall stops exports; does not touch network.cfg.
</CHANGES>

<!--
  NbdExport is intentionally separate from ThunderboltNet / UnraidFRR:
  no PHP requires across plugins. NBD is not controlled by network-extra.
-->

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NbdExport: preparing directories..."
rm -rf /usr/local/emhttp/plugins/NbdExport
rm -rf /usr/local/emhttp/plugins/nbdexport
mkdir -p /usr/local/emhttp/plugins/NbdExport/include
mkdir -p /usr/local/emhttp/plugins/NbdExport/scripts
mkdir -p /usr/local/emhttp/plugins/NbdExport/event
mkdir -p /usr/local/emhttp/plugins/NbdExport/docs
mkdir -p /boot/config/plugins/NbdExport
mkdir -p /var/run/nbdexport
mkdir -p /var/log/nbdexport
echo "NbdExport: directories ready."
]]></INLINE>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/NbdExport/NbdExport.page">
<URL>&raw;/NbdExport.page?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/NbdExport/default.cfg">
<URL>&raw;/default.cfg?v=&version;</URL>
</FILE>

<FILE Name="/usr/local/emhttp/plugins/NbdExport/README.md">
<INLINE>
<![CDATA[
**NBD Export**

Export a disk or partition as a **Network Block Device** (NBD) and image remote NBD targets to qcow2/raw on Unraid. Lives under **Settings → Network Services → NBD** next to NFS and SMB. Prefer private binds (Thunderbolt Net IPs when available). Read-only by default. Standalone — Thunderbolt Net and FRR are optional companions.
]]>
</INLINE>
</FILE>

