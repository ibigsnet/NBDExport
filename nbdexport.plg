<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NbdExport: finishing install..."
chmod 755 /usr/local/emhttp/plugins/NbdExport/scripts/nbd-export-start 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/NbdExport/scripts/nbd-export-stop 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/NbdExport/scripts/nbd-image-from-url 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/NbdExport/event/started 2>/dev/null || true
# Array-start hook
if [ -d /usr/local/emhttp/plugins ]; then
  mkdir -p /usr/local/emhttp/plugins/NbdExport/event
fi
# Unraid event symlink style (if present)
if [ -d /usr/local/emhttp/plugins/dynamix/event ]; then
  :
fi
# Install array-start event if Unraid plugin event path exists
EVDIR=/usr/local/emhttp/plugins/NbdExport/event
if [ -f "$EVDIR/started" ]; then
  chmod 755 "$EVDIR/started"
fi
# Also copy into boot event if using plugin event convention
mkdir -p /boot/config/plugins/NbdExport
if [ ! -f /boot/config/plugins/NbdExport/NbdExport.cfg ]; then
  if [ -f /usr/local/emhttp/plugins/NbdExport/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/NbdExport/default.cfg /boot/config/plugins/NbdExport/NbdExport.cfg
    echo "NbdExport: created default NbdExport.cfg"
  fi
fi
# Soft-link event into Unraid's plugin event system when available
if [ -d /usr/local/emhttp/plugins ]; then
  # Many plugins register via /boot/config/plugins/*/event or plg FILE — emhttp event/started is enough if plugin manager links it
  :
fi
php -r 'require_once "/usr/local/emhttp/plugins/NbdExport/include/nbd-lib.php"; nbd_write_companion_marker();' 2>/dev/null || true
echo "NbdExport: install complete."
echo "NbdExport: Settings → Network Services → NBD"
echo "NbdExport: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "NbdExport: removing plugin (full cleanup)..."

# 1) Stop managed listeners/jobs only (via state files — not global pkill qemu-nbd)
if [ -f /usr/local/emhttp/plugins/NbdExport/include/nbd-lib.php ]; then
  php -r '
    require_once "/usr/local/emhttp/plugins/NbdExport/include/nbd-lib.php";
    nbd_stop_all_exports();
    foreach (nbd_jobs_state() as $j) {
      if (!empty($j["id"])) { nbd_image_stop($j["id"]); }
    }
  ' 2>/dev/null || true
fi
# Best-effort: kill only pids recorded under our run dir
if [ -d /var/run/nbdexport ]; then
  for pf in /var/run/nbdexport/*.pid; do
    [ -f "$pf" ] || continue
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null || true)
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
      kill "$pid" 2>/dev/null || true
      sleep 0.2
      kill -9 "$pid" 2>/dev/null || true
    fi
  done
fi

# 2) Runtime + logs (RAM; not flash)
rm -rf /var/run/nbdexport
rm -rf /var/log/nbdexport

# 3) Emhttp tree (all case variants)
rm -rf /usr/local/emhttp/plugins/NbdExport
rm -rf /usr/local/emhttp/plugins/nbdexport
rm -rf /usr/local/emhttp/plugins/Nbdexport

# Stray tab pages if ever copied outside plugin dir
rm -f /usr/local/emhttp/webGui/Nbd*.page \
      /usr/local/emhttp/plugins/dynamix/Nbd*.page 2>/dev/null || true
find /usr/local/emhttp/webGui /usr/local/emhttp/plugins/dynamix -maxdepth 1 -type f \
  \( -name 'NbdExport.page' -o -name 'NbdStatus.page' -o -name 'NbdHost.page' \
     -o -name 'NbdPull.page' -o -name 'NbdSettings.page' \) -delete 2>/dev/null || true

# 4) Flash plugin state (cfg, companion). Unraid also removes nbdexport.plg from /boot/config/plugins/
# Flash: cfg + memory/presets (admin-only paths/IPs — wiped on uninstall like plugin state)
rm -rf /boot/config/plugins/NbdExport
rm -rf /boot/config/plugins/nbdexport
rm -f /boot/config/plugins/nbdexport.plg 2>/dev/null || true

# 5) Temp install copies
rm -f /tmp/plugins/nbdexport.plg /tmp/plugins/nbdexport.txt 2>/dev/null || true
rm -f /tmp/plugins/NbdExport* /tmp/inline*-nbdexport.sh 2>/dev/null || true

if [ -e /usr/local/emhttp/plugins/NbdExport ] || [ -e /usr/local/emhttp/plugins/nbdexport ]; then
  echo "NbdExport: WARNING — emhttp plugin path still present"
else
  echo "NbdExport: emhttp plugin paths clear"
fi
echo "NbdExport: removed."
echo "NbdExport: did not modify network.cfg, Thunderbolt Net, or UnraidFRR."
echo "NbdExport: user image files under /mnt/ were left untouched."
echo "NbdExport: hard-refresh the browser."
]]></INLINE>
</FILE>

</PLUGIN>
