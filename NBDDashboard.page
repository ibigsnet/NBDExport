<?php
/**
 * Dashboard tile — stock single-cell layout (icon + section), no dual-row
 * tile-header bar that stretches across the column.
 *
 * Heavy Host/Pull work runs async via nbd-dash-status.php so Main → Dashboard
 * first paint stays cheap. Markup must be a clean <tbody> (no leading <style>).
 */
$pluginname = 'NBDExport';

try {
  $mytiles[$pluginname]['column3'] = <<<'EOT'
<tbody id="tblNBDExport" title="_(NBD Export)_">
<tr>
<td>
<i class="fa fa-database f32"></i>
<div class="section">_(NBD Export)_<br>
<span id="nbd-dash-summary" class="next-status">—</span>
<div id="nbd-dash-body" style="margin-top:0.35em"></div>
</div>
<a href="/Settings/NBDExport" title="_(Go to NBD Export)_"><i class="fa fa-fw fa-cog control"></i></a>
<script>
(function(){
  var timer=null;
  var busy=false;
  function fill(){
    if(busy) return;
    busy=true;
    fetch('/plugins/NBDExport/include/nbd-dash-status.php',{credentials:'same-origin',cache:'no-store'})
      .then(function(r){return r.json();})
      .then(function(d){
        var s=document.getElementById('nbd-dash-summary');
        var b=document.getElementById('nbd-dash-body');
        if(s&&d&&d.summary!=null) s.textContent=d.summary;
        if(b&&d&&d.html!=null) b.innerHTML=d.html;
        var ms=(d&&d.watch)?5000:15000;
        if(timer) clearInterval(timer);
        timer=setInterval(fill,ms);
      })
      .catch(function(){
        var b=document.getElementById('nbd-dash-body');
        if(b) b.innerHTML='<span class="orange-text">Unable to load status</span>';
      })
      .finally(function(){ busy=false; });
  }
  // Defer past Dashboard first paint (avoid blocking other tiles).
  if(window.requestIdleCallback){
    requestIdleCallback(function(){ setTimeout(fill,0); },{timeout:1200});
  }else{
    setTimeout(fill,200);
  }
})();
</script>
</td>
</tr>
</tbody>
EOT;
} catch (Throwable $e) {
  $mytiles['NBDExport']['column3'] = '<tbody id="tblNBDExport" title="NBD Export"><tr><td>'
    . '<i class="fa fa-database f32"></i><div class="section">NBD Export<br>'
    . '<span class="orange-text">Tile error</span></div></td></tr></tbody>';
}
?>
