Menu="Dashboard:5"
Title="NBD Export"
Cond="version_compare(parse_ini_file('/etc/unraid-version')['version'],'6.12.0','>=')"
---
<?php
/**
 * Dashboard tile — lightweight shell only.
 *
 * Heavy Host/Pull scanning runs via nbd-dash-status.php after first paint so we
 * do not block Main → Dashboard or flash a full-width header while PHP works.
 * Markup must be a clean <tbody> (no leading <style>).
 */
$pluginname = 'NBDExport';

try {
  $mytiles[$pluginname]['column3'] = <<<'EOT'
<tbody id="tblNBDExport" title="_(NBD Export)_">
<tr>
<td>
<span class="tile-header">
<span class="tile-header-left">
<i class="fa fa-database f32"></i>
<div class="section">
<h3 class="tile-header-main">_(NBD Export)_</h3>
<span id="nbd-dash-summary">…</span>
</div>
</span>
<span class="tile-header-right">
<span class="tile-header-right-controls">
<a href="/Settings/NBDExport" title="_(Go to NBD Export)_"><i class="fa fa-fw fa-cog control"></i></a>
</span>
</span>
</span>
</td>
</tr>
<tr><td>
<div id="nbd-dash-body"><span style="opacity:0.7">Loading…</span></div>
<script>
(function(){
  function fill(){
    fetch('/plugins/NBDExport/include/nbd-dash-status.php',{credentials:'same-origin',cache:'no-store'})
      .then(function(r){return r.json();})
      .then(function(d){
        var s=document.getElementById('nbd-dash-summary');
        var b=document.getElementById('nbd-dash-body');
        if(s&&d&&d.summary!=null) s.textContent=d.summary;
        if(b&&d&&d.html!=null) b.innerHTML=d.html;
      })
      .catch(function(){
        var b=document.getElementById('nbd-dash-body');
        if(b) b.innerHTML='<span class="orange-text">Unable to load status</span>';
      });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',fill);
  else fill();
  setInterval(fill,8000);
})();
</script>
</td></tr>
</tbody>
EOT;
} catch (Throwable $e) {
  $mytiles['NBDExport']['column3'] = '<tbody id="tblNBDExport" title="NBD Export"><tr><td>'
    . '<i class="fa fa-database f32"></i><div class="section">NBD Export<br>'
    . '<span class="orange-text">Tile error</span></div></td></tr></tbody>';
}
?>
