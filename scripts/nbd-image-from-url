#!/bin/bash
# shellcheck disable=SC2016  # PHP source inside single quotes is intentional
# Usage: nbd-image-from-url <nbd://host:port|/dev/…|/mnt/file> <output under /mnt> [qcow2|raw] [overwrite]
set -euo pipefail
URL="${1:-}"
OUT="${2:-}"
FMT="${3:-qcow2}"
OVW="${4:-}"
php -r '
require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php";
$r = nbd_image_start($argv[1], $argv[2], $argv[3], $argv[4] === "overwrite");
fwrite(STDOUT, json_encode($r, JSON_PRETTY_PRINT) . "\n");
exit(empty($r["ok"]) ? 1 : 0);
' -- "$URL" "$OUT" "$FMT" "$OVW"
