<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "NBDExport">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.09.27aa">
<!ENTITY launch "Settings/NBDExport">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/NBDExport/main/nbd.plg">
<!ENTITY github "ibigsnet/NBDExport">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/NBDExport/main">
<!ENTITY forum "https://forums.unraid.net/topic/200219-plugin-nbd-export-host-disks-over-network-block-device-image-to-qcow2raw/">
<!ENTITY plugdir "/usr/local/emhttp/plugins/NBDExport">
<!ENTITY configdir "/boot/config/plugins/NBDExport">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="database"
  min="6.12.0"
  support="&forum;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/main/README.md">

<CHANGES>
###&version;
- Plugin payload is a flash .txz from the GitHub Release (not re-fetched from main at boot).

###2026.09.09aa
- Bind must be an IP; pkill quotes it; do not delete install.plg.

###2026.09.08aa–ae
- History vs Delete file; Dashboard one tile; Scan LAN table; overlay install.

###2026.09.06aa–ac
- Hashed install (SHA256/MD5); restore Logs/Help/Dashboard.

###2026.08.26av–au
- Lighter live poll under Pull load; Pull/Host notifications.

###2026.08.26at–ar
- Dashboard full paths + stock tile; progress/ETA; Pause/Stop align.

### Older releases
- Full changelog: https://github.com/ibigsnet/NBDExport/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NBD Export: preparing..."
# Busy check BEFORE removepkg — do not tear down the plugin mid-Pull/Host
if [ -f /usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php ]; then
  BUSY_JSON=$(php -r '
    require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php";
    if (!function_exists("nbd_busy_snapshot")) { echo "{\"busy\":false}"; exit; }
    echo json_encode(nbd_busy_snapshot());
  ' 2>/dev/null || echo '{"busy":false}')
  BUSY=$(echo "$BUSY_JSON" | php -r '$j=@json_decode(stream_get_contents(STDIN),true); echo !empty($j["busy"])?"1":"0";' 2>/dev/null || echo 0)
  SUMMARY=$(echo "$BUSY_JSON" | php -r '$j=@json_decode(stream_get_contents(STDIN),true); echo $j["summary"]??"";')
  ALLOW=$(php -r '
    require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php";
    $c=nbd_load_cfg(); echo (($c["allow_upgrade_while_busy"]??"no")==="yes")?"1":"0";
  ' 2>/dev/null || echo 0)
  if [ "$BUSY" = "1" ] && [ "${NBD_FORCE_UPGRADE:-0}" != "1" ] && [ "$ALLOW" != "1" ]; then
    echo "NBD Export: REFUSING plugin update while busy ($SUMMARY)."
    echo "NBD Export: Pause or Stop Hosts/Pulls on the Status tab, then Update again."
    echo "NBD Export: (Protects scheduled/CA auto-updates from swapping code under a live convert.)"
    echo "NBD Export: Or: Settings → Allow upgrade while busy = Yes — or: NBD_FORCE_UPGRADE=1 plugin update …"
    exit 1
  fi
  if [ "$BUSY" = "1" ]; then
    echo "NBD Export: WARNING — upgrading while busy ($SUMMARY); live qemu/Host processes are left running."
    echo "NBD Export: Post-install will reconcile UI to those processes (in-flight job keeps its old progress wrapper)."
  fi
fi
# One-time legacy flash rename (NbdExport → NBDExport)
if [ -d /boot/config/plugins/NbdExport ]; then
  mkdir -p /boot/config/plugins/NBDExport
  cp -a /boot/config/plugins/NbdExport/. /boot/config/plugins/NBDExport/ 2>/dev/null || true
  if [ -f /boot/config/plugins/NBDExport/NbdExport.cfg ] && [ ! -f /boot/config/plugins/NBDExport/NBDExport.cfg ]; then
    mv /boot/config/plugins/NBDExport/NbdExport.cfg /boot/config/plugins/NBDExport/NBDExport.cfg
  fi
  rm -rf /boot/config/plugins/NbdExport
  echo "NBD Export: migrated flash config NbdExport → NBDExport"
fi
# Note: do not delete /tmp/plugins/nbd.plg here — Unraid uses it as the install working copy
rm -f /boot/config/plugins/nbdexport.plg \
      /var/log/plugins/nbdexport.plg 2>/dev/null || true
mkdir -p /boot/config/plugins/NBDExport /var/run/nbdexport /var/log/nbdexport
rm -rf /usr/local/emhttp/plugins/NbdExport \
       /usr/local/emhttp/plugins/nbdexport 2>/dev/null || true
echo "NBD Export: ready for file install."
]]></INLINE>
</FILE>

<!-- raw-files begin -->
<FILE Name="&configdir;/NBDExport-&version;-x86_64-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ibigsnet/NBDExport/releases/download/v&version;/NBDExport-&version;-x86_64-1.txz</URL>
<SHA256>b64df018e97454ff4506b6e0858a77dc1abb89a87dd944b68307cbbabad237c4</SHA256>
<MD5>43f1bd4015a527597b87a412cf1d84cb</MD5>
</FILE>
<!-- raw-files end -->

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NBD Export: finishing install..."
if [ ! -f /usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php ]; then
  echo "NBD Export: ERROR — package did not install (missing nbd-lib.php)"
  exit 1
fi
chmod 755 /usr/local/emhttp/plugins/NBDExport/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/NBDExport/event/started 2>/dev/null || true
if [ ! -f /boot/config/plugins/NBDExport/NBDExport.cfg ] \
   && [ -f /usr/local/emhttp/plugins/NBDExport/default.cfg ]; then
  cp -a /usr/local/emhttp/plugins/NBDExport/default.cfg /boot/config/plugins/NBDExport/NBDExport.cfg
  echo "NBD Export: created default NBDExport.cfg"
fi
# Companion marker only. UD HeadInline inject only when user enables overlay (Settings).
php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; nbd_write_companion_marker(); $c=nbd_load_cfg(); if (($c["ud_status_overlay"]??"no")==="yes") { nbd_ud_overlay_inject(); } else { nbd_ud_overlay_uninject(); }' 2>/dev/null || true
# Reattach live Hosts/Pulls after upgrade (qemu left running when busy-upgrade allowed)
php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; if (function_exists("nbd_reconcile_live")) { $r=nbd_reconcile_live(); echo "NBD Export: reconcile hosts=".($r["hosts"]??0)." pulls=".($r["pulls"]??0)." external=".($r["external"]??0)."\n"; }' 2>/dev/null || true
VER=$(sed -n 's/.*ENTITY version "\([^"]*\)".*/\1/p' /tmp/plugins/nbd.plg 2>/dev/null | head -1)
if [ -n "$VER" ]; then
  find /boot/config/plugins/NBDExport -maxdepth 1 -name 'NBDExport-*-x86_64-1.txz' ! -name "NBDExport-${VER}-x86_64-1.txz" -delete 2>/dev/null || true
fi
echo "NBD Export: packages now: $(ls /var/log/packages/NBDExport-* 2>/dev/null | xargs -n1 basename 2>/dev/null | tr '\n' ' ')"
echo "NBD Export: install complete."
echo "NBD Export: Settings → Network Services → NBD"
echo "NBD Export: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
#!/bin/bash
# Best-effort uninstall. Always exit 0 — Unraid restores the plugin symlink if this
# script returns non-zero (CA Apps "Uninstall" then looks like a no-op).
set +e
echo "NBD Export: removing..."

LIB="/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"
if [ -f "$LIB" ]; then
  # One-liners only — multiline php -r is fragile under /bin/bash + plugin popen
  php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; if (function_exists("nbd_ud_overlay_uninject")) nbd_ud_overlay_uninject();' >/dev/null 2>&1
  php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; if (function_exists("nbd_beacon_stop")) nbd_beacon_stop();' >/dev/null 2>&1
  echo "NBD Export: stopping managed Hosts and Pulls before wipe..."
  php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; if (function_exists("nbd_stop_all_exports")) nbd_stop_all_exports();' >/dev/null 2>&1
  php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; if (!function_exists("nbd_jobs_state")||!function_exists("nbd_image_stop")) exit(0); foreach (nbd_jobs_state() as $j) { if (!empty($j["id"])) { echo "NBD Export: stop ".$j["id"]."\n"; nbd_image_stop($j["id"]); } }' 2>/dev/null || true
fi

# Strip UD overlay inject from known layout files (StorageGuard pattern)
for f in \
  /usr/local/emhttp/webGui/include/DefaultPageLayout/HeadInlineJS.php \
  /usr/local/emhttp/plugins/dynamix/include/DefaultPageLayout/HeadInlineJS.php \
  /usr/local/emhttp/webGui/include/HeadInclude.php \
  /usr/local/emhttp/plugins/dynamix/include/HeadInclude.php
do
  [ -f "$f" ] || continue
  sed -i \
    -e '/NBDExport-inject/d' \
    -e '/NBDExport UD overlay/d' \
    -e '/plugins\/NBDExport\/include\/nbd-ud/d' \
    "$f" >/dev/null 2>&1
done

# Kill anything we tracked under the run dir (hosts, jobs, beacon)
if [ -d /var/run/nbdexport ]; then
  for pf in /var/run/nbdexport/*.pid; do
    [ -f "$pf" ] || continue
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null)
    [ -n "$pid" ] || continue
    if [ -d "/proc/$pid" ]; then
      kill -TERM -$pid >/dev/null 2>&1
      kill -TERM "$pid" >/dev/null 2>&1
      sleep 0.2
      kill -KILL -$pid >/dev/null 2>&1
      kill -KILL "$pid" >/dev/null 2>&1
    fi
  done
fi
# Beacon php -S can outlive a missing pidfile
pkill -f 'nbd-beacon-server.php' >/dev/null 2>&1
pkill -f 'php -S .*10808' >/dev/null 2>&1

rm -rf /var/run/nbdexport /var/log/nbdexport >/dev/null 2>&1

# Packages (current + legacy names)
for p in /var/log/packages/NBDExport-* /var/log/packages/NbdExport-* /var/log/packages/nbdexport-*; do
  [ -e "$p" ] || continue
  echo "NBD Export: removepkg $(basename "$p")"
  removepkg "$(basename "$p")" >/dev/null 2>&1
done

# Emhttp plugin trees (current + legacy)
rm -rf \
  /usr/local/emhttp/plugins/NBDExport \
  /usr/local/emhttp/plugins/NbdExport \
  /usr/local/emhttp/plugins/nbdexport >/dev/null 2>&1

# Flash config + cached .txz (full wipe — reinstall starts clean)
rm -rf \
  /boot/config/plugins/NBDExport \
  /boot/config/plugins/NbdExport \
  /boot/config/plugins/nbdexport >/dev/null 2>&1

# Orphan / misnamed plg copies on flash (keep Unraid working copy in /tmp during remove)
rm -f \
  /boot/config/plugins/nbdexport.plg \
  /boot/config/plugins/NBDExport.plg \
  /boot/config/plugins/NbdExport.plg >/dev/null 2>&1

rm -f \
  /tmp/plugins/nbd.txt \
  /tmp/plugins/nbdexport.plg \
  /tmp/plugins/NBDExport.plg \
  /var/log/plugins/nbdexport.plg \
  /var/log/plugins/NBDExport.plg >/dev/null 2>&1

# Note: do not delete /tmp/plugins/nbd.plg here — Unraid install/remove working copy
# Note: do not touch /boot/config/plugins-removed/ (Unraid-owned)
# Note: user-exported JSON under /boot/config/nbdexport-config-*.json is left alone
# Note: user qcow2/raw under /mnt/ are never deleted

echo "NBD Export: removed."
exit 0
]]></INLINE>
</FILE>

</PLUGIN>
