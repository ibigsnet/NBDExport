<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name "NBDExport">
<!ENTITY author "RifleJock">
<!ENTITY version "2026.08.15ad">
<!ENTITY launch "Settings/NBDExport">
<!ENTITY pluginURL "https://raw.githubusercontent.com/ibigsnet/NBDExport/main/nbd.plg">
<!ENTITY github "ibigsnet/NBDExport">
<!ENTITY raw "https://raw.githubusercontent.com/ibigsnet/NBDExport/main">
<!ENTITY forum "https://forums.unraid.net/topic/200219-plugin-nbd-export-host-disks-over-network-block-device-image-to-qcow2raw/">
<!ENTITY plugdir "/usr/local/emhttp/plugins/NBDExport">
<!ENTITY configdir "/boot/config/plugins/NBDExport">
<!ENTITY pkg "NBDExport-&version;-x86_64-1">
<!ENTITY pkgfile "&pkg;.txz">
]>

<PLUGIN name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  icon="database"
  min="6.12.0"
  support="&forum;"
  project="https://github.com/&github;"
  readme="https://raw.githubusercontent.com/&github;/stable/README.md">

<CHANGES>
###&version;
- Install: single runtime <code>.txz</code> (docs on GitHub only).
- Plugins changelog shows recent entries; full history linked below.

###2026.08.15aa
- **Pull:** Scan network → <strong>Stop scanning</strong> (distinct color) while a scan is in progress.

###2026.08.14az
- **Host:** Listen port shows default <strong>10809</strong> in blue when the field is empty (Unraid placeholder).

###2026.08.14ay
- **Host:** multi-network bind via checkboxes (one <code>qemu-nbd</code> per selected IP, same disk/port).

###2026.08.14ax
- **Docs:** public README/docs hygiene — no lab hostnames; private notes stay local.

###2026.08.14aw
- **Pull:** warn (does not block) when output extension mismatches format
  (e.g. qcow2 + <code>.img</code>, raw + <code>.qcow2</code>); live hint + confirm.

###2026.08.14av
- **UD overlay:** no empty reserved slots on unhosted disks (stock layout restored);
  badges only on active Hosts, absolutely positioned to avoid column reflow.

### Older releases
- Full changelog (all versions): https://github.com/ibigsnet/NBDExport/blob/main/CHANGELOG.md
</CHANGES>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NBD Export: preparing..."
# Legacy NbdExport → NBDExport flash migration
if [ -d /boot/config/plugins/NbdExport ]; then
  mkdir -p /boot/config/plugins/NBDExport
  cp -a /boot/config/plugins/NbdExport/. /boot/config/plugins/NBDExport/ 2>/dev/null || true
  if [ -f /boot/config/plugins/NBDExport/NbdExport.cfg ] && [ ! -f /boot/config/plugins/NBDExport/NBDExport.cfg ]; then
    mv /boot/config/plugins/NBDExport/NbdExport.cfg /boot/config/plugins/NBDExport/NBDExport.cfg
  fi
  rm -rf /boot/config/plugins/NbdExport
  echo "NBD Export: migrated flash config from NbdExport → NBDExport"
fi
rm -f /boot/config/plugins/install.plg /boot/config/plugins/nbdexport.plg \
      /var/log/plugins/install.plg /var/log/plugins/nbdexport.plg 2>/dev/null || true
# Drop previous multi-FILE install tree + old packages (upgrade path)
rm -rf /usr/local/emhttp/plugins/NBDExport /usr/local/emhttp/plugins/NbdExport /usr/local/emhttp/plugins/nbdexport
# Keep only this version's package on flash
mkdir -p /boot/config/plugins/NBDExport
rm -f /boot/config/plugins/NBDExport/NBDExport-*.txz 2>/dev/null || true
mkdir -p /var/run/nbdexport /var/log/nbdexport
echo "NBD Export: ready for package install."
]]></INLINE>
</FILE>

<FILE Name="/boot/config/plugins/NBDExport/&pkgfile;" Run="upgradepkg --install-new --reinstall">
<URL>&raw;/archive/&pkgfile;?v=&version;</URL>
</FILE>

<FILE Run="/bin/bash">
<INLINE><![CDATA[
echo "NBD Export: finishing install..."
# Permissions
chmod 755 /usr/local/emhttp/plugins/NBDExport/scripts/* 2>/dev/null || true
chmod 755 /usr/local/emhttp/plugins/NBDExport/event/started 2>/dev/null || true
# Default cfg on first install
if [ ! -f /boot/config/plugins/NBDExport/NBDExport.cfg ]; then
  if [ -f /usr/local/emhttp/plugins/NBDExport/default.cfg ]; then
    cp -a /usr/local/emhttp/plugins/NBDExport/default.cfg /boot/config/plugins/NBDExport/NBDExport.cfg
    echo "NBD Export: created default NBDExport.cfg"
  fi
fi
# Companion + optional UD overlay
php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; nbd_write_companion_marker(); nbd_ud_overlay_inject();' 2>/dev/null || true
echo "NBD Export: install complete."
echo "NBD Export: Settings → Network Services → NBD"
echo "NBD Export: Hard-refresh the browser (Ctrl+Shift+R)."
]]></INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
<INLINE><![CDATA[
echo "NBD Export: removing plugin (full cleanup)..."

# 0) Soft head hook for opt-in Unassigned Devices badges
if [ -f /usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php ]; then
  php -r 'require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php"; nbd_ud_overlay_uninject();' 2>/dev/null || true
fi
for f in \
  /usr/local/emhttp/webGui/include/DefaultPageLayout/HeadInlineJS.php \
  /usr/local/emhttp/plugins/dynamix/include/DefaultPageLayout/HeadInlineJS.php \
  /usr/local/emhttp/webGui/include/HeadInclude.php \
  /usr/local/emhttp/plugins/dynamix/include/HeadInclude.php
do
  [ -f "$f" ] || continue
  sed -i '/NBDExport UD overlay/d' "$f" 2>/dev/null || true
done

# 1) Stop managed listeners/jobs only
if [ -f /usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php ]; then
  php -r '
    require_once "/usr/local/emhttp/plugins/NBDExport/include/nbd-lib.php";
    nbd_stop_all_exports();
    foreach (nbd_jobs_state() as $j) {
      if (!empty($j["id"])) { nbd_image_stop($j["id"]); }
    }
  ' 2>/dev/null || true
fi
if [ -d /var/run/nbdexport ]; then
  for pf in /var/run/nbdexport/*.pid; do
    [ -f "$pf" ] || continue
    pid=$(tr -cd '0-9' <"$pf" 2>/dev/null || true)
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
      kill "$pid" 2>/dev/null || true
      sleep 0.2
      kill -9 "$pid" 2>/dev/null || true
    fi
  done
fi

# 2) Runtime + logs
rm -rf /var/run/nbdexport /var/log/nbdexport

# 3) Package database + emhttp tree
removepkg NBDExport 2>/dev/null || true
for p in /var/log/packages/NBDExport-*; do
  [ -e "$p" ] || continue
  removepkg "$(basename "$p")" 2>/dev/null || true
done
rm -rf /usr/local/emhttp/plugins/NBDExport
rm -rf /usr/local/emhttp/plugins/NbdExport
rm -rf /usr/local/emhttp/plugins/nbdexport

# 4) Flash plugin state + cached packages
rm -rf /boot/config/plugins/NBDExport
rm -rf /boot/config/plugins/NbdExport
rm -rf /boot/config/plugins/nbdexport
rm -f /boot/config/plugins/nbd.plg /boot/config/plugins/nbdexport.plg /boot/config/plugins/install.plg 2>/dev/null || true
rm -f /tmp/plugins/nbd.plg /tmp/plugins/nbdexport.plg /tmp/plugins/install.plg 2>/dev/null || true

if [ -e /usr/local/emhttp/plugins/NBDExport ] || [ -e /usr/local/emhttp/plugins/nbdexport ]; then
  echo "NBD Export: WARNING — some plugin paths still present"
else
  echo "NBD Export: removed."
fi
]]></INLINE>
</FILE>

</PLUGIN>
