<script>
(function () {
  window.nbdJobsSelectByStatus = function (status) {
    var boxes = document.querySelectorAll('.nbd-job-cb');
    for (var i = 0; i < boxes.length; i++) {
      if (status === false) {
        boxes[i].checked = false;
      } else if (status === null) {
        boxes[i].checked = true;
      } else {
        boxes[i].checked = (boxes[i].getAttribute('data-nbd-status') === status);
      }
    }
  };
  window.nbdJobsClearClick = function (all) {
    var fin = document.getElementById('nbd_clear_finished');
    if (fin) fin.value = all ? 'yes' : 'no';
    if (!all) {
      var boxes = document.querySelectorAll('.nbd-job-cb:checked');
      if (!boxes.length) {
        alert('Check at least one History job first, or use Remove all finished from list.');
        return false;
      }
      return confirm('Remove ' + boxes.length + ' checked job(s) from the History list?\n\nFiles under /mnt are kept. Use Delete image on a card to free space.');
    }
    return confirm('Remove all Done/Failed/Idle jobs from the History list?\n\nFiles under /mnt are kept. Use Delete image on a card to free space.');
  };
  window.nbdJobsClearSubmit = function () { return true; };
  document.addEventListener('click', function (ev) {
    var editBtn = ev.target && ev.target.closest ? ev.target.closest('.nbd-job-edit-toggle') : null;
    if (editBtn) {
      var eid = editBtn.getAttribute('data-nbd-edit');
      var ebox = eid ? document.getElementById('nbd-edit-' + eid) : null;
      if (ebox) {
        ebox.style.display = (ebox.style.display === 'none' || ebox.style.display === '') ? 'block' : 'none';
      }
      return;
    }
    var bugBtn = ev.target && ev.target.closest ? ev.target.closest('.nbd-job-bug-btn') : null;
    if (!bugBtn) return;
    var bid = bugBtn.getAttribute('data-nbd-bug');
    var panel = bid ? document.getElementById('nbd-bug-' + bid) : null;
    if (!panel) return;
    panel.hidden = !panel.hidden;
    if (!panel.hidden) {
      try {
        panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      } catch (e) { /* ignore */ }
    }
  });
  window.nbdCopyDiagnostics = function (id) {
    var el = document.getElementById('nbd-diag-' + id);
    if (!el) return;
    var text = el.value || el.textContent || '';
    function ok() {
      try {
        el.focus();
        el.select();
      } catch (e) { /* ignore */ }
    }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(ok).catch(function () {
        ok();
        try { document.execCommand('copy'); } catch (e2) { /* ignore */ }
      });
    } else {
      ok();
      try { document.execCommand('copy'); } catch (e3) { /* ignore */ }
    }
  };
})();
</script>
