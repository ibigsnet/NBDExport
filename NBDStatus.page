<script>
(function () {
  window.nbdJobsSelectByStatus = function (status) {
    var boxes = document.querySelectorAll('.nbd-job-cb');
    for (var i = 0; i < boxes.length; i++) {
      if (status === false) {
        boxes[i].checked = false;
      } else if (status === null) {
        boxes[i].checked = true;
      } else {
        boxes[i].checked = (boxes[i].getAttribute('data-nbd-status') === status);
      }
    }
  };
  window.nbdJobsClearClick = function (all) {
    var fin = document.getElementById('nbd_clear_finished');
    if (fin) fin.value = all ? 'yes' : 'no';
    var del = document.getElementById('nbd_delete_outputs');
    var delOn = del && del.checked;
    if (!all) {
      var boxes = document.querySelectorAll('.nbd-job-cb:checked');
      if (!boxes.length) {
        alert('Select at least one finished job (checkbox), or use Clear all finished.');
        return false;
      }
      var msg = 'Clear ' + boxes.length + ' selected job(s) from the list?';
      if (delOn) msg += '\n\nAlso DELETE their output image files under /mnt (cannot undo).';
      else msg += '\n\nImage files under /mnt are kept unless “Also delete image files” is checked.';
      return confirm(msg);
    }
    var msg2 = 'Remove all Done/Failed/Idle jobs from this list?';
    if (delOn) msg2 += '\n\nAlso DELETE their output image files under /mnt (cannot undo).';
    else msg2 += '\n\nImage files under /mnt are kept unless “Also delete image files” is checked.';
    return confirm(msg2);
  };
  window.nbdJobsClearSubmit = function () { return true; };
  window.nbdRetrySubmit = function (form, msg) {
    var rmId = form.getAttribute('data-nbd-rm');
    var cb = rmId ? document.getElementById(rmId) : null;
    var hidden = form.querySelector('.nbd-rmout-hidden');
    var del = !!(cb && cb.checked);
    if (hidden) hidden.value = del ? 'yes' : 'no';
    var m = msg || 'Retry this Pull?';
    if (del) m += '\n\nExisting output file will be deleted first.';
    return confirm(m);
  };
  document.addEventListener('click', function (ev) {
    var btn = ev.target && ev.target.closest ? ev.target.closest('.nbd-job-edit-toggle') : null;
    if (!btn) return;
    var id = btn.getAttribute('data-nbd-edit');
    var box = id ? document.getElementById('nbd-edit-' + id) : null;
    if (!box) return;
    box.style.display = (box.style.display === 'none' || box.style.display === '') ? 'block' : 'none';
  });
})();
</script>
