require_once '/usr/local/emhttp/plugins/NBDExport/include/nbd-page-boot.php';
nbd_page_styles();

$jobs_active = [];
$jobs_queued = [];
$jobs_history = [];
foreach ($jobs as $j) {
  $k = nbd_job_ui_status($j)['key'] ?? 'idle';
  if ($k === 'running' || $k === 'paused') {
    $jobs_active[] = $j;
  } elseif ($k === 'queued') {
    $jobs_queued[] = $j;
  } else {
    $jobs_history[] = $j;
  }
}
if (function_exists('nbd_queued_jobs_ordered')) {
  $jobs_queued = nbd_queued_jobs_ordered();
}
$n_clearable = 0;
foreach ($jobs_history as $j) {
  if (function_exists('nbd_job_is_clearable') && nbd_job_is_clearable($j)) {
    $n_clearable++;
  }
}
