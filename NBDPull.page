$nbd_scan_lans = function_exists('nbd_scan_local_lans') ? nbd_scan_local_lans() : [];
if ($nbd_scan_lans) {
  usort($nbd_scan_lans, static function ($a, $b) {
    $rank = static function ($r) {
      if (!empty($r['thunderbolt'])) {
        return 0;
      }
      if (!empty($r['extra'])) {
        return 3;
      }
      if (!empty($r['default_route'])) {
        return 2;
      }
      return 1;
    };
    $d = $rank($a) - $rank($b);
    if ($d !== 0) {
      return $d;
    }
    return strnatcmp((string)($a['iface'] ?? ''), (string)($b['iface'] ?? ''));
  });
}
