<script>
(function () {
  var destructiveOn = <?= $destructive === 'yes' ? 'true' : 'false' ?>;

  window.nbdConfirmDestructiveSave = function (form) {
    if (!form) return true;
    var sel = form.querySelector('[name="destructive_mode"]');
    if (!sel || sel.value !== 'yes') return true;
    return window.confirm(
      'Enable Destructive mode?\n\n' +
      'This allows:\n' +
      '• Writable NBD exports (peer can write your disk)\n' +
      '• Exporting Unraid array / mounted / flash devices\n\n' +
      'Leave OFF unless you need those. You can turn it back off anytime.'
    );
  };

  window.nbdConfirmExport = function (form) {
    var conf = form.querySelector('#nbd_confirm');
    if (conf) conf.value = 'no';
    var devSel = form.querySelector('#nbd_device');
    var roSel = form.querySelector('#nbd_read_only');
    if (!devSel || !devSel.value) {
      window.alert('Select a device to export.');
      return false;
    }
    var opt = devSel.options[devSel.selectedIndex];
    var warn = opt && opt.getAttribute('data-warn') === '1';
    var flags = (opt && opt.getAttribute('data-flags')) || '';
    var ro = !roSel || roSel.value === 'yes';
    var needConfirm = !ro || warn;

    if (!ro && !destructiveOn) {
      window.alert(
        'Writable export is blocked.\n\n' +
        'Enable Destructive mode under Settings (Apply), or set Read-only to Yes.'
      );
      return false;
    }
    if (warn && !destructiveOn) {
      window.alert(
        'This device is marked risky (' + (flags || 'array/mounted') + ').\n\n' +
        'Enable Destructive mode under Settings (Apply) before exporting array, mounted, or flash devices.\n' +
        'Prefer an unassigned, unmounted disk for imaging.'
      );
      return false;
    }

    if (needConfirm) {
      var msg = 'Start NBD listener (qemu-nbd server) for:\n  ' + devSel.value + '\n\n';
      msg += 'This shares the disk over the network on the bind IP:port.\n';
      msg += 'It does NOT copy data by itself — a client must connect (image job or qemu-img).\n\n';
      if (!ro) {
        msg += 'WARNING: WRITABLE — the peer can modify or wipe this disk.\n\n';
      } else {
        msg += 'Read-only listener (peer cannot write).\n\n';
      }
      if (warn) {
        msg += 'Device flags: ' + (flags || 'risky') + '\n\n';
      }
      msg += 'Continue?';
      if (!window.confirm(msg)) {
        return false;
      }
      // Second confirm for writable
      if (!ro) {
        if (!window.confirm(
          'FINAL CONFIRMATION\n\nWritable NBD listener for ' + devSel.value + '.\n' +
          'A mistake can destroy data.\n\nClick OK only if intentional.'
        )) {
          return false;
        }
      }
      if (conf) conf.value = 'yes';
    } else {
      // Safe RO path — light confirm still helps fat-finger Start
      if (!window.confirm(
        'Start read-only NBD listener for ' + devSel.value + '?\n\n' +
        'This runs qemu-nbd (server). Clients use nbd://IP:port to image the disk.'
      )) {
        return false;
      }
      // Safe path does not need server-side confirm flag
      if (conf) conf.value = 'no';
    }
    return true;
  };

  window.nbdConfirmImage = function (form) {
    var out = form.querySelector('#nbd_image_out');
    var path = out ? String(out.value || '').trim() : '';
    if (!path) {
      window.alert('Enter an output path under /mnt/…');
      return false;
    }
    if (path.indexOf('/dev/') === 0) {
      window.alert('Output cannot be a block device (/dev/…). Use a file path under /mnt/.');
      return false;
    }
    return window.confirm(
      'Start image job (client):\n  write → ' + path + '\n\n' +
      'Pulls from the NBD URL into a file via qemu-img convert.\n' +
      'Does not wipe a local disk. Does not start a listener. Continue?'
    );
  };
})();
</script>
