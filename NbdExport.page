  <div class="nbd-section">
    <h3>Active exports</h3>
<?php if (!$exports): ?>
    <p class="nbd-muted">No active exports.</p>
<?php else: ?>
    <table class="nbd-data tablesorter">
      <thead>
        <tr>
          <th>Status</th>
          <th>Device</th>
          <th>Bind / URL</th>
          <th>RO</th>
          <th>Label</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
<?php foreach ($exports as $e):
  $alive = !empty($e['alive']) || !empty($e['listening']);
?>
        <tr>
          <td><?= $alive ? '<span class="nbd-badge nbd-badge-ok">Up</span>' : '<span class="nbd-badge">Down</span>' ?></td>
          <td><code><?= htmlspecialchars($e['device'] ?? '') ?></code></td>
          <td>
